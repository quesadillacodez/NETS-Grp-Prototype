
# Copy this file to .env and fill in your NETS Sandbox credentials.
# Get these from https://sandbox.nets.openapipaas.com (or your team lead).
VITE_NETS_BASE_URL=https://sandbox.nets.openapipaas.com/api/v1
VITE_NETS_API_KEY=
VITE_NETS_PROJECT_ID=
VITE_NETS_TXN_ID=

# Server-side security. Never prefix these with VITE_; they must not enter the browser bundle.
# Generate a production secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
NETS_DATA_FILE=server/data/auth-store.json
OTP_WEBHOOK_URL=
OTP_WEBHOOK_TOKEN=
# Required only when creating a brand-new production data store. Keep it in the
# host's secret manager, then rotate each initial PIN after first sign-in.
NETS_SEED_USERS_JSON=

# Local development only. Set false to verify that OTPs are never returned to the UI.
EXPOSE_DEMO_OTP=true
